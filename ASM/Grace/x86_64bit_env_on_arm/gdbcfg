set disassembly-flavor intel

# Optional TUI: asm pane + registers pane (uncomment `layout dev` to enable)
tui new-layout dev asm 2 regs 1 status 1 cmd 1
#layout dev

# Live view on every stop: next instructions, all GP registers, stack, flags
display/15i $rip
display/x $rbp
display/x $rsp
display/x $rax
display/x $rbx
display/x $rcx
display/x $rdx
display/x $rdi
display/x $rsi
display/x $r8
display/x $r9
display/x $r10
display/x $r11
display/x $r12
display/x $r13
display/x $r14
display/x $r15
display/20gx $rsp
display/t $eflags

# Your session — edit the breakpoint to your function under test.
# Program args come from the command line (in-shell) or ARGS= (make debug).
b main
continue
